# Domain
DOMAIN=intercopy.co.uk
API_DOMAIN=api.intercopy.co.uk
AUTH_DOMAIN=auth.intercopy.co.uk

# PostgreSQL
POSTGRES_USER=intercopy
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
CONTENT_DB=content_localization
KEYCLOAK_DB=keycloak

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# .NET API
ASPNETCORE_ENVIRONMENT=Production

# Billing (dev compose defaults to false, prod compose defaults to true)
BILLING_ENABLED=false
# Who may use this environment: comma-separated emails and/or @domains. Empty = anyone.
ALLOWED_EMAILS=you@example.com,@yourcompany.com
